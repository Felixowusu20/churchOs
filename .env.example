# Neon / Postgres
# Prefer the *pooled* connection string (-pooler. in the host) for the Next.js app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
# Non-pooled / direct URL for migrations (prisma migrate / db push)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=

# Auth
AUTH_SECRET=
ADMIN_JWT_SECRET=

# Only used for first bootstrap; registration still blocks once an admin exists
ADMIN_OPEN_REGISTRATION="true"
